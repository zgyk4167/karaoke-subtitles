# Copy to .env (same directory) and fill in. Never commit .env.
# Environment variables that are already set take precedence over this file.

DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must match the key's region. `pipeline.py doctor` checks this (one free request).
# Beijing (default): https://dashscope.aliyuncs.com
# Singapore:         https://dashscope-intl.aliyuncs.com
DASHSCOPE_BASE=https://dashscope.aliyuncs.com

# Optional. Leave empty to use the default: transcribe uploads the audio to DashScope's
# free temporary storage (kept 48 h, readable only by your account's ASR model).
# To use your own storage instead, set a shell command that uploads the file given as $1
# and prints a public, presigned or oss:// URL.
# Alibaba Cloud OSS (ossutil):
# AUDIO_URL_CMD='ossutil cp "$1" oss://YOUR_BUCKET/ -f >/dev/null && ossutil sign "oss://YOUR_BUCKET/$(basename "$1")" --timeout 3600'
# Amazon S3 (aws cli):
# AUDIO_URL_CMD='aws s3 cp "$1" s3://YOUR_BUCKET/ >/dev/null && aws s3 presign "s3://YOUR_BUCKET/$(basename "$1")" --expires-in 3600'
AUDIO_URL_CMD=
